              <groupfilter function='member' level='[none:product_category_name_english:nk]' member='&quot;electronics&quot;' />
              <groupfilter function='member' level='[none:product_category_name_english:nk]' member='&quot;tablets_printing_image&quot;' />
              <groupfilter function='member' level='[none:product_category_name_english:nk]' member='&quot;telephony&quot;' />
